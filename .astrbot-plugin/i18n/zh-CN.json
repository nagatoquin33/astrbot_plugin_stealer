{
    "metadata": {
        "display_name": "表情包小偷",
        "short_desc": "自动偷取并智能发送表情包",
        "desc": "监听聊天中的图片并使用 VLM 自动分类存储，对话时根据情绪智能匹配并发送表情包。支持 LLM 主动搜索表情包、WebUI 管理面板、存储清理、作用域修复、智能情绪匹配和多平台适配。"
    },
    "config": {
        "_steal_section": {
            "description": "偷图设置",
            "hint": ""
        },
        "_send_section": {
            "description": "发送设置",
            "hint": ""
        },
        "_model_section": {
            "description": "模型配置（视觉 / 情绪分析 / 嵌入检索）",
            "hint": ""
        },
        "_group_section": {
            "description": "目标过滤",
            "hint": ""
        },
        "_storage_section": {
            "description": "存储管理",
            "hint": ""
        },
        "steal_meme": {
            "description": "开启表情包偷取功能",
            "hint": "开启后会监听并保存聊天中的图片。需确保已配置视觉模型，否则无法分类入库。"
        },
        "steal_mode": {
            "description": "偷图模式",
            "hint": "概率模式：每次收到图片时按设定概率决定是否偷取。冷却模式：两次偷取之间必须间隔指定秒数。"
        },
        "steal_chance": {
            "description": "偷图概率",
            "hint": "设为 0 时从不偷取，设为 1 时每次都偷取。建议 0.2~0.5。仅概率模式生效。"
        },
        "content_filtration": {
            "description": "内容审核",
            "hint": "开启后使用 VLM 审核图片内容，过滤不当图片。开启后会增加单张图片的处理时间。"
        },
        "auto_send_meme": {
            "description": "自动随聊发送表情包",
            "hint": "开启后 Bot 会在聊天中自动发送表情包。关闭后仅收集不入库，或仅通过指令手动发送。"
        },
        "auto_meme_cancel_on_new_message": {
            "description": "新消息取消待发送表情",
            "hint": "开启后同一会话有新消息到达时，会取消上一轮仍在延迟等待中的自动表情，避免旧回复配新图。"
        },
        "meme_chance": {
            "description": "表情包发送概率",
            "hint": "设为 0 时从不发送，设为 1 时每次都发送。建议 0.1~0.3，避免刷屏。"
        },
        "send_meme_as_gif": {
            "description": "以 GIF 格式发送",
            "hint": "开启后始终以 GIF 输出，更接近真表情包样式。关闭时按原文件格式发送（png/jpg/gif 等）。开启后高频发送大图/动图场景会有较高瞬时内存占用。"
        },
        "meme_send_delay": {
            "description": "固定延迟（秒）",
            "hint": "等待此时间后发送表情包，避免与分段插件冲突。建议 5.0 秒以上，让分段先发完。设为 0 则立即发送。"
        },
        "smart_meme_selection": {
            "description": "智能表情包选择",
            "hint": "开启后使用综合评分（多样性 + 匹配度 + 相似度）选出最合适的表情包。关闭则随机选择（仍会避免短期重复）。"
        },
        "enable_natural_emotion_analysis": {
            "description": "智能提取检索词",
            "hint": "开启后用轻量模型从 AI 回复中提取检索词和情绪先验，增强表情包匹配；是否发送仍由概率/冷却等原有门控决定。关闭后直接用 AI 回复原文检索。"
        },
        "emotion_analysis_provider_id": {
            "description": "情绪分析专用模型",
            "hint": "留空则使用当前会话模型。小参数量模型即可胜任，建议使用轻量免费模型以降低延迟和消耗。"
        },
        "vision_provider_id": {
            "description": "视觉模型",
            "hint": "用于图片分类。留空则自动使用 AstrBot 全局配置的图片描述模型（default_image_caption_provider_id）。"
        },
        "send_target_whitelist": {
            "description": "发表情白名单",
            "hint": "格式：group:群号 或 user:QQ号。非空时仅白名单内的目标允许自动发送表情包。"
        },
        "send_target_blacklist": {
            "description": "发表情黑名单",
            "hint": "格式：group:群号 或 user:QQ号。可与白名单同时生效，冲突时按下方优先级规则判定。"
        },
        "send_target_filter_mode": {
            "description": "发表情名单优先级",
            "hint": "白名单优先：白名单命中时允许，否则再查黑名单。黑名单优先：黑名单命中时拒绝，否则再查白名单。"
        },
        "steal_target_whitelist": {
            "description": "偷表情白名单",
            "hint": "格式：group:群号 或 user:QQ号。非空时仅白名单内的目标允许自动偷取。"
        },
        "steal_target_blacklist": {
            "description": "偷表情黑名单",
            "hint": "格式：group:群号 或 user:QQ号。可与白名单同时生效，冲突时按下方优先级规则判定。"
        },
        "steal_target_filter_mode": {
            "description": "偷表情名单优先级",
            "hint": "白名单优先：白名单命中时允许，否则再查黑名单。黑名单优先：黑名单命中时拒绝，否则再查白名单。"
        },
        "max_reg_num": {
            "description": "最大表情包数量",
            "hint": "表情包存储上限。达到上限后自动按清理策略淘汰旧表情包。"
        },
        "steal_pool_capacity": {
            "description": "待审核池容量上限",
            "hint": "自动偷取的图片先进「待审核池」。达到此数量后暂停自动偷取，待人工在 WebUI 审核区处理（通过入库或删除）腾出空间后自动恢复。调整后即时生效，无需重启。"
        },
        "audit_required": {
            "description": "自动偷取需人工审核",
            "hint": "开启后自动偷取的图片进入「待审核池」，需在 WebUI 审核区人工通过后才正式入库。关闭后跳过审核，自动偷取的图片直接入库分类，请配合内容审核开关使用以避免低质量图片污染图库。"
        },
        "enable_embedding_search": {
            "description": "启用嵌入向量检索",
            "hint": "开启后用远程文本嵌入按语义召回（图上文字 + 使用场景 + 描述）。关闭则只用关键词（BM25）。不使用本地 CLIP。未配置嵌入模型时自动降级为 BM25。"
        },
        "embedding_provider_id": {
            "description": "嵌入模型 ID",
            "hint": "用于生成表情包语义向量的嵌入模型。留空则自动使用 AstrBot 首个可用的 Embedding Provider。在 AstrBot 管理后台 → LLM 配置中可查看已配置的 Embedding 模型 ID（通常以 _embedding 结尾，如 openai_embedding、qwen_embedding 等）。此字段填写的是 Embedding 模型 ID，不是聊天模型或视觉模型 ID。"
        },
        "_smart_section": {
            "description": "智能选择：文字距离融合权重预设",
            "hint": ""
        },
        "_webui_section": {
            "description": "WebUI",
            "hint": ""
        },
        "webui_theme": {
            "description": "WebUI 默认主题",
            "hint": "打开「表情管理」时使用的主题。在页面里切换也会记住上次选择，优先于这项。"
        },
        "_advanced_section": {
            "description": "高级配置",
            "hint": ""
        },
        "custom_meme_classification_prompt": {
            "description": "VLM 分类提示词",
            "hint": "支持占位符：{emotion_list}（分类列表）。为空时使用默认提示词。"
        },
        "custom_meme_classification_with_filter_prompt": {
            "description": "VLM 分类提示词（带审核）",
            "hint": "开启内容审核时使用的 VLM 分类提示词。支持占位符：{emotion_list}（分类列表）。为空时使用默认提示词。"
        },
        "emotion_analysis_prompt": {
            "description": "情绪分析提示词",
            "hint": "生成检索词和 1~3 个情绪先验。支持占位符：{emotion_list}、{llm_reply}、{user_message}。为空时使用默认提示词。兼容旧的单分类名输出。"
        },
        "sim_weight_preset": {
            "description": "文字距离融合预设",
            "hint": "预设决定多个相似度算法的融合权重：均衡（默认）、关键词优先（子串/字符重叠更敏感）、语义优先（n-gram/余弦更重）、严格匹配（编辑距离和字符级更重，减少误发）。"
        }
    },
